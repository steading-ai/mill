# The base image a machine boots from: docs/sandbox.md §Images §Base. Built
# on the host by `mill image build-base --push` from a weekly timer
# (contrib/systemd/mill-image-build.timer), published to Harbor as
# mill/base:<date> and mill/base:latest, and resolved to a digest at each
# provision. The worker derives a repository's image from it by digest,
# exports the result flat into a btrfs subvolume, and restores the two file
# capabilities `podman export` drops (README.md, "What export must do").
#
# Contains: systemd as PID 1, dbus-broker, rootless podman for the user
# agent, git, sudo, mise with node for the harness, and the toolchain native
# extensions build against. Contains no credential, no skill and no sidecar:
# those are the worker's, mounted at provision.

# The Harbor host every registry pull goes through: the Fedora base here and,
# inside the machine, docker.io, quay.io and ghcr.io through the proxy
# projects the host's own registries.conf names (homestead#31).
ARG HARBOR_HOST=harbor.tailcbcc0e.ts.net
FROM ${HARBOR_HOST}/fedora-cache/fedora:44
ARG HARBOR_HOST

# The system and the toolchain: what ruby-build, node-gyp and linked crates
# need to compile against, and procps-ng because a check step will pgrep.
# ca-certificates is upgraded explicitly: the Harbor proxy can serve a
# fedora:44 cached before the distribution's current trust store.
RUN dnf -y upgrade ca-certificates \
    && dnf -y install \
      systemd dbus-broker podman git sudo curl procps-ng \
      gcc gcc-c++ make pkgconf python3 \
      openssl-devel zlib-devel libffi-devel libyaml-devel \
      readline-devel ncurses-devel gdbm-devel sqlite-devel \
    && dnf clean all

RUN curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh \
    && /usr/local/bin/mise --version

# The session user. Its subordinate ids sit inside the machine's own 65536
# uids (--private-users=pick); useradd's default range starts past it and
# the kernel refuses the map (spike E2).
RUN useradd -u 1000 -m agent \
    && echo 'agent:10000:55536' > /etc/subuid \
    && echo 'agent:10000:55536' > /etc/subgid \
    && mkdir -p /work && chown agent:agent /work

# The mount point of the mill skill, made as agent's ahead of the bind. A
# mount point nspawn has to create is root's, and ~/.claude is where the
# harness writes a session's own settings and transcripts: with the
# directory root-owned every one of those writes is refused
# (docs/sandbox.md §"Skill mount").
RUN mkdir -p /home/agent/.claude/skills/mill \
    && chown -R agent:agent /home/agent/.claude

# The mount points of the mill sidecar and the workflow directory, made as
# agent's ahead of the binds, for the same reason the skill's is: nspawn
# makes a missing mount point as root, and the worker binds both read-only
# here at provision — neither is baked in (docs/sandbox.md §"Skill mount").
# The image's node runs the sidecar; a check step runs its script from the
# workflow copy.
RUN mkdir -p /home/agent/.local/share/mill/sidecar /home/agent/.local/share/mill/workflow \
    && chown -R agent:agent /home/agent/.local

# The parents of every default cache mount point (docs/sandbox.md
# §Caching's table), made as agent's ahead of the binds, for the same
# reason again: nspawn makes a missing mount point and its parents as
# root, and a tool that writes a sibling under one — mise's own lockfiles
# beside ~/.cache/go-build, a package under ~/.local/share beside mise's
# data — is refused with the parent root's.
RUN mkdir -p /home/agent/.cache /home/agent/.local/share /home/agent/go/pkg \
      /home/agent/.cargo /home/agent/.npm /home/agent/.bun/install /home/agent/.gem \
    && chown -R agent:agent /home/agent/.cache /home/agent/.local /home/agent/go \
      /home/agent/.cargo /home/agent/.npm /home/agent/.bun /home/agent/.gem

# Node for the harness's runtime, installed globally through mise so a
# session's own mise.toml can still choose another.
RUN MISE_DATA_DIR=/usr/local/share/mise MISE_CACHE_DIR=/tmp/mise-cache \
      /usr/local/bin/mise use --global node@lts \
    && MISE_DATA_DIR=/usr/local/share/mise /usr/local/bin/mise exec -- node --version \
    && ln -s "$(MISE_DATA_DIR=/usr/local/share/mise /usr/local/bin/mise which node)" /usr/local/bin/node \
    && ln -s "$(MISE_DATA_DIR=/usr/local/share/mise /usr/local/bin/mise which npm)" /usr/local/bin/npm \
    && rm -rf /tmp/mise-cache

# Podman's socket at the system level and for agent's user manager: linger
# starts that manager at boot, and the wants link enables the socket with
# no manager running to be asked. Storage is overlay under the ephemeral
# root; containers land under the step's slice (cgroups = "split"); the
# public registries resolve to Harbor's proxy projects.
COPY storage.conf containers.conf /etc/containers/
COPY registries.conf /etc/containers/registries.conf.d/harbor.conf
RUN sed -i "s/@HARBOR_HOST@/${HARBOR_HOST}/g" /etc/containers/registries.conf.d/harbor.conf \
    && systemctl enable podman.socket \
    && mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/agent \
    && mkdir -p /home/agent/.config/systemd/user/sockets.target.wants \
    && ln -s /usr/lib/systemd/user/podman.socket \
         /home/agent/.config/systemd/user/sockets.target.wants/podman.socket \
    && chown -R agent:agent /home/agent/.config

# The machine's side of its veth: systemd's own 80-container-host0.network
# takes a lease from the host's DHCP server on ve-mill-* (docs/sandbox.md
# §Network), and for a nested machine 80-container-ve.network masquerades
# an inner machine's traffic through the outer (§Self-hosting). Fedora's
# preset leaves networkd off; without it the machine has no route out.
RUN systemctl enable systemd-networkd.service

# nspawn masks /proc's sensitive paths, and podman's pause process copies
# that mount table; a pristine proc stacked over it at boot is what lets
# rootless podman start (spike E2). A unit in the image, so no exec has to
# do it.
COPY mill-proc.service /etc/systemd/system/mill-proc.service
RUN systemctl enable mill-proc.service

# The dnf shim and the one sudo path it uses: `/usr/bin/dnf install`, and
# nothing else, as root (docs/sandbox.md §"The dnf shim").
COPY dnf /usr/local/bin/dnf
RUN chmod 0755 /usr/local/bin/dnf \
    && echo 'agent ALL=(root) NOPASSWD: /usr/bin/dnf install *' > /etc/sudoers.d/agent-dnf \
    && chmod 0440 /etc/sudoers.d/agent-dnf \
    && visudo -cf /etc/sudoers.d/agent-dnf

# The checkout is trusted before any session sees it, so `mise install`
# runs without a prompt.
RUN su agent -c '/usr/local/bin/mise trust /work' \
    && su agent -c '/usr/local/bin/mise trust --show'

# A booted machine wants a fresh machine-id; an empty file tells systemd to
# generate one at boot.
RUN : > /etc/machine-id
