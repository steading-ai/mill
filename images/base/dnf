#!/bin/sh
# /usr/local/bin/dnf: the dnf shim, docs/sandbox.md §"The dnf shim".
# `install` runs privileged through the one sudoers rule; everything else is
# dnf as the caller, so `search` and `info` still work and `remove` is
# refused where the rule is. On success the hint is the last three lines,
# because that is where an agent reads.
set -u
case "${1:-}" in
  install) ;;
  *) exec /usr/bin/dnf "$@" ;;
esac
shift
# sudo resets the environment, so the proxy every exec carries has to be
# handed to dnf as an option or the mirrors never answer; after `install`,
# because the sudoers rule is `/usr/bin/dnf install *`.
proxy="${HTTPS_PROXY:-${https_proxy:-}}"
sudo /usr/bin/dnf install ${proxy:+--setopt=proxy="$proxy"} "$@" || exit $?
packages=""
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *) packages="$packages${packages:+, }\"$arg\"" ;;
  esac
done
# The report to the run's provenance: the workspace socket's `report.install`
# verb, over the socket directory the host bound at boot, with the step's
# token as the bearer every verb wants. No socket, no token, or a socket
# that does not answer the verb costs the agent nothing: the install is
# done, and the hint below is still the last thing it reads.
if [ -S /run/mill/ws.sock ] && [ -n "${STEP_TOKEN:-}" ]; then
  curl -sS --max-time 5 --unix-socket /run/mill/ws.sock -X POST \
    -H "Authorization: Bearer $STEP_TOKEN" -H 'Content-Type: application/json' \
    --data "{\"packages\":[$packages]}" http://mill/v1/report.install >/dev/null 2>&1 || true
fi
printf 'mill: installed %s into an ephemeral machine; the next run'"'"'s image will not have it.\n' "$(echo "$packages" | tr -d '"')"
printf 'mill: declare it in mill.toml so the image does. Under [image], add:\n'
printf 'mill:   packages = [%s]\n' "$packages"
