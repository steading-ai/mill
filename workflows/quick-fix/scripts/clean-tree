#!/usr/bin/env bash
# Fail if the checkout has anything uncommitted.
#
# The check step after commit: MVP grants exec to steps that may not write,
# and exec can write, so the workflow detects what it cannot yet prevent
# (docs/domain-model.md §"Capability set"). Diagnostics go to stderr, which
# is what the session sees as the next prompt when this fails.
set -euo pipefail

dirty=$(git status --porcelain)
if [ -n "$dirty" ]; then
  {
    echo "Workspace is dirty: stage, delete, or ignore uncommitted files."
    echo
    echo "$dirty"
  } >&2
  exit 1
fi
