# The mill service: the store and a worker in one process, as a system unit
# under the `mill` account the package's sysusers fragment creates. The
# package installs it as /usr/lib/systemd/system/mill.service; from a
# checkout,
#
#   install -Dm644 contrib/systemd/mill.service /etc/systemd/system/mill.service
#
# dagger identifies a caller by the numeric user id on its socket and has no
# principal kind for an orchestrator, so the account this unit runs as is the
# dagger principal every claim is made by (docs/domain-model.md §Principal).
# A deployment that wants mill to act as the operator overrides the account
# with a drop-in and nothing else:
#
#   # /etc/systemd/system/mill.service.d/user.conf
#   [Service]
#   User=<operator>
#   Group=<operator>
#
# That works because nothing is owned by `mill` at install time. The state
# and runtime directories are declared below rather than made by a
# scriptlet, so systemd creates /var/lib/mill and /run/mill at start and
# gives them to whichever account the unit runs as — chowning what an
# earlier account left there. The overriding account needs to reach dagger's
# socket, which is a matter of dagger's group.
#
# DATABASE_URL and any other environment come from /etc/mill/env, one
# KEY=value per line, read by systemd and never by a session. What the
# worker claims and how it runs — its projects, its labels, the sidecar and
# workflow paths, the workspace backend — is /etc/mill/config.yaml, whose
# keys are the long flag names. A flag on the ExecStart line below wins over
# the file.
#
# Readiness is sd_notify: the unit is active only once the service has bound
# its socket, applied its migrations, and had the database answer, so
# anything ordered After= it can rely on all three.

[Unit]
Description=mill: a workflow runner over dagger's work graph
Documentation=https://github.com/steading-ai/mill
After=network.target dagger.service

[Service]
Type=notify
NotifyAccess=main
User=mill
Group=mill
EnvironmentFile=-%E/mill/env
# The credential gateway's upstream credential, when `gateway: true` is in
# the configuration file: a `claude setup-token`, delivered as a file under
# $CREDENTIALS_DIRECTORY and read from nowhere else — never the environment
# file above (docs/sandbox.md §Credentials). Uncomment once the file exists;
# a LoadCredential= that names a missing file fails the unit's start.
#LoadCredential=claude-oauth:%E/mill/claude-oauth
# The forge token the same way: delivered as $CREDENTIALS_DIRECTORY/forge-token
# and read before MILL_FORGE_TOKEN, so it need not be in the environment file
# at all. ImportCredential= finds it in the system credential store —
# /etc/credstore/forge-token, or encrypted under /etc/credstore.encrypted —
# and, unlike LoadCredential=, a missing one does not fail the start.
# Uncomment once the file is delivered (docs/tools.md §Forges).
#ImportCredential=forge-token
ConfigurationDirectory=mill
StateDirectory=mill
StateDirectoryMode=0750
RuntimeDirectory=mill
RuntimeDirectoryMode=0750
# Other accounts reach the store only if a role map names them; add
# --roles %E/mill/roles.json once one exists. Without it the service's own
# account is the only caller, which is the ordinary case while mill and the
# operator share one.
# One process, both faces: the store and a worker over it. The Connect
# boundary between them is still there, so a second worker on another host
# stays a configuration change (docs/architecture.md §"One binary, two
# faces").
#
# --env-mode strict is what a deployment wants: a session's sidecar is given
# a named floor plus what its step asked for, and not this unit's own
# environment — which carries DATABASE_URL, and MILL_FORGE_TOKEN when the
# EnvironmentFile above still sets it. The default, inherit, is for a person running
# `mill run` from their shell. A step that needs more than the floor names it
# in its workflow, as `env.passthrough` (docs/architecture.md §"Skill steps:
# the harness adapter").
ExecStart=/usr/bin/mill serve --work --env-mode strict --socket %t/mill/mill.sock --config %E/mill/config.yaml
# On stop the worker goes first — it releases its lease as a preemption with
# detail "shutdown" and leaves its run resumable — and the store drains
# after it. That is the worker's --grace (30s by default) plus serve's
# --shutdown-timeout (30s), so give it both and a margin. A second SIGTERM
# inside the window kills the sessions, which is what SendSIGKILL does at
# the end of this timeout anyway.
TimeoutStopSec=90
KillSignal=SIGTERM
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
